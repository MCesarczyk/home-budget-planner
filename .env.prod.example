# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod

# --- Django core ---
# Generate a fresh one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
# Your host(s)/domain(s), comma-separated, WITHOUT port. Must be set when
# DEBUG=False. e.g. example.com  (or srv28.mikr.us if using the raw host).
# MUST include `web`: the frontend proxies /api to this service as web:8000, so
# Django sees Host=web on those requests — omitting it yields 400 DisallowedHost.
ALLOWED_HOSTS=example.com,www.example.com,web
# Origins allowed for unsafe requests — include scheme AND port if non-standard.
# HTTPS: https://example.com   |   plain HTTP on a port: http://some.origin.com:12345
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# HTTPS posture. Leave True when serving over HTTPS (cookies become Secure +
# HTTPS hardening on). Set False ONLY if serving over plain HTTP with no TLS —
# otherwise login cookies won't be sent over http. Plain HTTP is unencrypted
# (JWT/credentials in the clear); use HTTPS for anything real.
SECURE_COOKIES=True

# Load the demo/sample dataset on start. Defaults to DEBUG, so prod stays empty
# (schema only) — migrations no longer carry sample data. Set True only to seed a
# staging box with the demo data. Seeding is idempotent (skips if data exists).
# SEED_DEMO_DATA=False

# --- External PostgreSQL (managed/production DB) ---
POSTGRES_DB=hbp
POSTGRES_USER=hbp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=your-db-host.example.com
POSTGRES_PORT=5432

# --- Initial Django superuser (created idempotently on first start) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong

# Number of trusted reverse proxies in front of the app (you have one). Makes
# login throttling key off the real client IP and resist X-Forwarded-For spoofing.
NUM_PROXIES=1

# --- Optional HTTPS hardening (enable once TLS is stable at the proxy) ---
# SECURE_SSL_REDIRECT=False   # usually the reverse proxy already redirects
# SECURE_HSTS_SECONDS=31536000

