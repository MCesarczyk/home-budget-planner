# Production environment for docker-compose.prod.yml.
# Copy to .env.prod and fill in real values. NEVER commit .env.prod.
#   cp .env.prod.example .env.prod

# --- Django core ---
# Generate a fresh one, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
# Your domain(s), comma-separated. Must be set when DEBUG=False.
ALLOWED_HOSTS=example.com,www.example.com
# Origins allowed for unsafe requests — include the scheme (https://).
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- External PostgreSQL (managed/production DB) ---
POSTGRES_DB=hbp
POSTGRES_USER=hbp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=your-db-host.example.com
POSTGRES_PORT=5432

# --- Initial Django superuser (created idempotently on first start) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong

# --- Optional HTTPS hardening (enable once TLS is stable at the proxy) ---
# SECURE_SSL_REDIRECT=False   # usually the reverse proxy already redirects
# SECURE_HSTS_SECONDS=31536000
