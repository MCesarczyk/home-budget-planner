#!/usr/bin/env sh
set -e

# Lint + auto-fix only the staged files, then re-stage them.
pnpm exec lint-staged

# Scan the staged diff for secrets. Mirrors .github/workflows/detect-secrets.yml.
# Prefers a local binary (brew install gitleaks), falls back to the image.
GITLEAKS_IMAGE=zricethezav/gitleaks:v8.30.1

if command -v gitleaks >/dev/null 2>&1; then
	gitleaks git --pre-commit --staged --redact --no-banner --verbose
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
	docker run --rm -v "$(git rev-parse --show-toplevel):/repo" -w /repo \
		"$GITLEAKS_IMAGE" git --pre-commit --staged --redact --no-banner --verbose
else
	printf '\033[1;33m⚠ gitleaks and docker both unavailable — staged secret scan skipped\033[0m\n'
	printf '  install it with: brew install gitleaks\n'
fi
