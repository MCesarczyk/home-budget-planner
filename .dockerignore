# Never ship the local dev database — the container creates + seeds its own.
db.sqlite3
*.sqlite3

# VCS / tooling
.git
.gitignore
.ropeproject/

# Python caches
__pycache__/
*.py[cod]
.venv/
venv/

# Local data dumps (gitignored) — not needed in the image.
dump/

# Secrets / env files — must never be baked into the image.
.env
.env.*

# Collected static — regenerated in-container by the entrypoint.
staticfiles/

# Docker files themselves
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.prod.yml
